body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.card {
    background: #fff;
    width: 350px;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.card img {
    width: 100%;
    display: block;
}

.card-content {
    padding: 20px;
}

.card-content h3 {
    color: #0a2a66;
    margin-bottom: 12px;
}

.card-content ul {
    list-style-type: disc;
    margin-left: 20px;
    margin-bottom: 20px;
    color: #333;
    line-height: 1.6;
}

.card-content ul li {
    margin-bottom: 6px;
}

.btn {
    display: inline-block;
    text-decoration: none;
    background: #007bff;
    color: #fff;
    padding: 10px 18px;
    border-radius: 5px;
    font-weight: bold;
    transition: background 0.3s ease;
}

.btn:hover {
    background: #0056b3;
}
